// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 3 — Real Users and Sessions
// ---------------------------------------------------------------------------

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  // Default hash is 'password123' so unseeded Lab 2 users can login.
  passwordHash           String    @default("$2b$10$gumpaF8EQG4qN4/WfnJtduwsgZHRiaeZL292zSI1OMF3YDXB0c/ta") 
  role                   String    @default("Requester") // Requester, IT Staff, Administrator
  isActive               Boolean   @default(true)
  requiresPasswordChange Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt @default(now())

  // Relations
  ticketsCreated         Ticket[]          @relation("TicketRequester")
  ticketsOwned           Ticket[]          @relation("TicketOwner")
  sessions               Session[]
  publicComments         PublicComment[]
  internalNotes          InternalNote[]
  actionsPerformed       ActionTaken[]          @relation("ActionPerformer")
  editedActionRevisions  ActionTakenRevision[]  @relation("ActionRevisionEditor")

  // Prisma model is named User, physical PostgreSQL table remains "RequesterUser"
  // This is intentional to reuse the populated Lab 2 table and preserve existing data/relations.
  @@map("RequesterUser")
}

model Session {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  userId       Int
  lastActiveAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Issue 3 — Create Ticket models
// ---------------------------------------------------------------------------

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id              Int           @id @default(autoincrement())
  categoryId      Int
  relatedSystemId Int
  summary         String
  priority        String        @default("Medium") // e.g., Low, Medium, High, Critical
  itPriority      String        @default("Medium") // Copied from priority by application logic
  description     String
  status          String        @default("New")
  requesterId     Int
  ownerId         Int?          // Primary IT Staff owner
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt @default(now())
  resolvedAt      DateTime?

  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  requester       User          @relation("TicketRequester", fields: [requesterId], references: [id])
  owner           User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  attachments     Attachment[]
  publicComments  PublicComment[]
  internalNotes   InternalNote[]
  actionsTaken    ActionTaken[]
}

model Attachment {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  fileName      String
  fileType      String
  fileSize      Int
  filePath      String
  isDeleted     Boolean  @default(false)
  removalReason String?
  createdAt     DateTime @default(now())

  ticket        Ticket   @relation(fields: [ticketId], references: [id])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model ActionTaken {
  id                Int                   @id @default(autoincrement())
  ticketId          Int
  actionDateTime    DateTime              @default(now())
  actionDescription String
  result            String
  performedById     Int
  followUpRequired  Boolean               @default(false)
  followUpNote      String?
  attachmentNotes   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt @default(now())

  // Relations: Protect audit history with onDelete: Restrict
  ticket            Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy       User                  @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  revisions         ActionTakenRevision[]

  @@index([ticketId])
  @@index([performedById])
}

model ActionTakenRevision {
  id             String      @id @default(uuid())
  actionTakenId  Int
  editedById     Int
  editedAt       DateTime    @default(now())
  beforeSnapshot Json        // Complete snapshot of editable fields prior to modification
  afterSnapshot  Json        // Complete snapshot of editable fields after modification

  actionTaken    ActionTaken @relation(fields: [actionTakenId], references: [id], onDelete: Restrict)
  editedBy       User        @relation("ActionRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@index([actionTakenId, editedAt])
  @@index([editedById])
}

model IdempotencyKey {
  id           Int      @id @default(autoincrement())
  key          String   // UUIDv4 provided by client
  route        String   // e.g. "POST /api/tickets/:id/actions"
  ticketId     Int
  userId       Int
  requestHash  String   // SHA-256 hash of canonical request body
  statusCode   Int?     // Stored HTTP response status code (null while in-flight reservation)
  responseBody String?  // Serialized response JSON payload (null while in-flight reservation)
  createdAt    DateTime @default(now())
  expiresAt    DateTime // createdAt + 24 hours

  @@unique([route, ticketId, userId, key])
  @@index([expiresAt])
}
